    title: "Generation Capacity Expansion in Imperfectly Competitive Restructured Electricity Markets"
    authors:
      - family-names: Murphy
        given-names: Frederic H.
      - family-names: Smeers
        given-names: Yves
    journal: "Operations Research"
    volume: 53
    issue: 4
    start: 646
    end: 661
    year: 2005
    doi: "10.1287/opre.1050.0211"
