    given-names: Archie
    orcid: "https://orcid.org/0000-0002-5055-3004"
version: 0.1.0
date-released: 2026-10-13
license: BSD-3-Clause
repository-code: "https://github.com/archiechapman/CapacityEquilibriaBenchmarks.jl"
keywords:
  - capacity expansion
  - equilibrium
  - complementarity
  - MPCC
  - benchmark
  - Julia
references:
